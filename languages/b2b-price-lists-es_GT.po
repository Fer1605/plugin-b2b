"no se puede deshacer."

#: includes/Admin/Views/rule-group-delete-confirm.php:76
msgid "Yes, delete this rule permanently"
msgstr "Sí, eliminar esta regla permanentemente"

#: includes/Admin/Views/rule-group-form.php:124
msgid "Edit price rule"
msgstr "Editar regla de precio"

#: includes/Admin/Views/rule-group-form.php:124
msgid "Add price rule"
msgstr "Añadir regla de precio"

#: includes/Admin/Views/rule-group-form.php:125
msgid "Pick a product and say what this list pays for it"
msgstr "Elija un producto y diga cuánto paga esta lista por él"

